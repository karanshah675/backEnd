<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>users</title>
</head>
<body>
    <table border="1">
        <tr>
            <th>id</th>
            <th>username</th>
            <th>email</th>
        </tr>
        <% for(i of result){%>
            <tr>
                <td><%= i.id %></td>
                <td><%= i.username %></td>
                <td><%= i.email %></td>
                <td><a href="http://localhost:8080/<%= i.id %>/edit">edit</a></td>
            </tr>
        <% } %>
        <tr>
            
        </tr>
    </table>
</body>
</html>