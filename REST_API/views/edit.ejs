<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>edit <%= post.username  %></title>
</head>
<body>
    <h3><%= post.username %></h3>
    <form method="post" action="/posts/<%= post.id %>?_method=PATCH">
        <textarea name="content" placeholder="enter content" id="">
            <%= post.content %>
        </textarea>
        <br>
        <input type="submit" value="edit post">
    </form>
</body>
</html>